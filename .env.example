# ---------- Site ----------
NEXT_PUBLIC_SITE_NAME=minted
NEXT_PUBLIC_SITE_URL=https://your-domain.com
# "devnet" while testing, "mainnet-beta" when live
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
# Public RPC the browser uses to confirm transactions (a Helius/Triton URL with a browser-safe key)
NEXT_PUBLIC_SOLANA_RPC=https://api.devnet.solana.com
# Set to 1 to show demo creators in the directory when the database is empty
NEXT_PUBLIC_DEMO_DIRECTORY=0

# ---------- Auth (Auth.js + X OAuth 2.0) ----------
# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=https://your-domain.com
# From developer.x.com > your app > Keys and tokens > OAuth 2.0 Client ID and Secret
AUTH_TWITTER_ID=
AUTH_TWITTER_SECRET=
# App-only Bearer token (same app). Used to re-read profiles at launch and in the daily refresh.
X_BEARER_TOKEN=

# ---------- Database (Supabase or Neon Postgres) ----------
# Use the pooled connection string (Supabase: "Transaction pooler", port 6543)
DATABASE_URL=

# ---------- Solana ----------
# Server RPC (keep this one private)
SOLANA_RPC_URL=https://api.devnet.solana.com
# Priority fee in micro-lamports per compute unit
PRIORITY_FEE_MICROLAMPORTS=200000

# ---------- IPFS (Pinata) ----------
PINATA_JWT=
# Your dedicated gateway, without trailing slash, e.g. https://yourname.mypinata.cloud
PINATA_GATEWAY=https://gateway.pinata.cloud

# ---------- Launch rules ----------
MAX_INITIAL_BUY_SOL=5
# Only X Premium (blue), Verified Organizations and government accounts can launch
ALLOWED_VERIFIED_TYPES=blue,business,government
# 0 = no follower minimum
MIN_FOLLOWERS=0
MIN_ACCOUNT_AGE_DAYS=90
HANDLE_CHANGE_COOLDOWN_HOURS=24
# Slippage allowed on the creator's first buy, in percent
INITIAL_BUY_SLIPPAGE_PCT=5

# ---------- Cron ----------
# Vercel sends this as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=
